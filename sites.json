{
  "$comment": "Where the post and comment boxes are, per site, so the sign control can sit beside them. This list places the control and nothing else: nothing in verification, canonicalisation, URL handling or the site derivation reads it, and a site with no entry still signs from the toolbar popup or the context menu. Add or fix an entry with a pull request. `site` is the registrable domain; `selectors` are CSS selectors of the editable boxes; `binding` is `page` unless the site is a chat service with a stable URL per channel.",
  "sites": [
    { "site": "x.com", "name": "X", "selectors": ["div[data-testid='tweetTextarea_0']", "div[data-testid^='tweetTextarea_']"], "binding": "page" },
    { "site": "twitter.com", "name": "X", "selectors": ["div[data-testid='tweetTextarea_0']", "div[data-testid^='tweetTextarea_']"], "binding": "page" },
    { "site": "youtube.com", "name": "YouTube", "selectors": ["#contenteditable-root", "ytd-commentbox #contenteditable-root"], "binding": "page" },
    { "site": "reddit.com", "name": "Reddit", "selectors": ["shreddit-composer [contenteditable='true']", "div[contenteditable='true'][role='textbox']", "textarea[name='text']"], "binding": "page" },
    { "site": "linkedin.com", "name": "LinkedIn", "selectors": ["div.ql-editor[contenteditable='true']", "div.comments-comment-box__form div[contenteditable='true']"], "binding": "page" },
    { "site": "facebook.com", "name": "Facebook", "selectors": ["div[contenteditable='true'][role='textbox']"], "binding": "page" },
    { "site": "instagram.com", "name": "Instagram", "selectors": ["textarea[aria-label='Add a comment…']", "textarea[aria-label='Add a comment...']"], "binding": "page" },
    { "site": "threads.net", "name": "Threads", "selectors": ["div[contenteditable='true'][role='textbox']"], "binding": "page" },
    { "site": "github.com", "name": "GitHub", "selectors": ["textarea#new_comment_field", "textarea[name='comment[body]']", "textarea[name='issue[body]']", "textarea[name='pull_request[body]']"], "binding": "page" },
    { "site": "news.ycombinator.com", "name": "Hacker News", "selectors": ["textarea[name='text']"], "binding": "page" },
    { "site": "mastodon.social", "name": "Mastodon", "selectors": ["textarea.autosuggest-textarea__textarea"], "binding": "page" },
    { "site": "bsky.app", "name": "Bluesky", "selectors": ["div[contenteditable='true'][role='textbox']"], "binding": "page" },
    { "site": "slack.com", "name": "Slack", "selectors": ["div.ql-editor[contenteditable='true']"], "binding": "channel" },
    { "site": "discord.com", "name": "Discord", "selectors": ["div[role='textbox'][contenteditable='true']"], "binding": "channel" },
    { "site": "localhost", "name": "The development demo", "selectors": ["textarea#demo-box"], "binding": "page" }
  ]
}
